<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/viewerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050507"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/playerStage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/imgStream"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Tela transmitida ao vivo"
            android:scaleType="fitCenter" />

        <VideoView
            android:id="@+id/videoCinema"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:visibility="gone" />

        <WebView
            android:id="@+id/webCinema"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtViewerStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="24dp"
            android:background="#CC0B0B10"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:text="Conectando à transmissão ao vivo..."
            android:textColor="#E4E4E7"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/layoutTopOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="#CC050507"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTabLive"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:text="Ao Vivo"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                app:backgroundTint="#C8102E"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTabCinema"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:text="Cinema"
                android:textAllCaps="false"
                android:textColor="#E4E4E7"
                android:textSize="12sp"
                app:cornerRadius="8dp"
                app:strokeColor="#3F3F46" />

            <TextView
                android:id="@+id/txtStageTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Jogos do Mengão"
                android:textColor="#F4F4F5"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTvWifiToggle"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:text="Wi-Fi TV"
                android:textAllCaps="false"
                android:textColor="#D4D4D8"
                android:textSize="11sp"
                android:visibility="gone"
                app:cornerRadius="8dp"
                app:strokeColor="#3F3F46" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSairViewer"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:text="Conta"
                android:textAllCaps="false"
                android:textColor="#D4D4D8"
                android:textSize="11sp"
                app:cornerRadius="8dp"
                app:strokeColor="#3F3F46" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutBottomOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#D9050507"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConectar"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="12dp"
                    android:text="Conectar"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    app:backgroundTint="#C8102E"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAudioMute"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="Som: Ligado"
                    android:textAllCaps="false"
                    android:textColor="#E4E4E7"
                    android:textSize="12sp"
                    app:cornerRadius="8dp"
                    app:strokeColor="#3F3F46" />

                <TextView
                    android:id="@+id/txtSyncBadge"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:maxLines="1"
                    android:text="Tela Ajustada"
                    android:textColor="#A1A1AA"
                    android:textSize="11sp" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSizeSmall"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="10dp"
                        android:text="Pequena"
                        android:textAllCaps="false"
                        android:textColor="#E4E4E7"
                        android:textSize="11sp"
                        app:cornerRadius="8dp"
                        app:strokeColor="#3F3F46" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSizeMedium"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginStart="6dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="10dp"
                        android:text="Média"
                        android:textAllCaps="false"
                        android:textColor="#E4E4E7"
                        android:textSize="11sp"
                        app:cornerRadius="8dp"
                        app:strokeColor="#3F3F46" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSizeFit"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginStart="6dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="10dp"
                        android:text="Ajustar"
                        android:textAllCaps="false"
                        android:textColor="#E4E4E7"
                        android:textSize="11sp"
                        app:cornerRadius="8dp"
                        app:strokeColor="#3F3F46" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSizeFill"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginStart="6dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="10dp"
                        android:text="Preencher"
                        android:textAllCaps="false"
                        android:textColor="#E4E4E7"
                        android:textSize="11sp"
                        app:cornerRadius="8dp"
                        app:strokeColor="#3F3F46" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSizeFullscreen"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginStart="6dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="10dp"
                        android:text="Tela Cheia"
                        android:textAllCaps="false"
                        android:textColor="#E4E4E7"
                        android:textSize="11sp"
                        app:cornerRadius="8dp"
                        app:strokeColor="#3F3F46" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/layoutTvWifiDrawer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#101016"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/inputEndereco"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="#1E293B"
            android:hint="http://192.168.1.50:8080"
            android:imeOptions="actionNext"
            android:inputType="textUri"
            android:paddingHorizontal="10dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#94A3B8"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/inputToken"
            android:layout_width="110dp"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:background="#1E293B"
            android:hint="TC-XXXXXX"
            android:imeOptions="actionDone"
            android:inputType="textCapCharacters"
            android:paddingHorizontal="8dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#94A3B8"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConnectWifi"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:text="IP"
            android:textAllCaps="false"
            android:textSize="12sp"
            app:backgroundTint="#C8102E" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollCinemaShelf"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#09090D"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Programação do Cinema"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtCinemaSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Filmes sincronizados no horário definido"
                        android:textColor="#A1A1AA"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRefreshCinema"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="Atualizar"
                    android:textAllCaps="false"
                    android:textColor="#E4E4E7"
                    android:textSize="11sp"
                    app:cornerRadius="8dp"
                    app:strokeColor="#3F3F46" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutCinemaCpfCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#121218"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ingresso Cinema via Pix · Sem Cadastro"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtCinemaPixInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Carregando dados do Pix..."
                    android:textColor="#34D399"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/inputViewerCpf"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="8dp"
                    android:background="#1E293B"
                    android:hint="Digite seu CPF (11 dígitos) · Sem cadastro"
                    android:inputType="number"
                    android:maxLength="14"
                    android:paddingHorizontal="10dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#94A3B8"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVerifyCpf"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Entrar com CPF"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        app:backgroundTint="#C8102E"
                        app:cornerRadius="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRequestPixTicket"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Já fiz o Pix"
                        android:textAllCaps="false"
                        android:textColor="#34D399"
                        android:textSize="12sp"
                        app:cornerRadius="8dp"
                        app:strokeColor="#059669" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtCpfStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Após fazer o Pix, digite seu CPF acima. Acesso válido até o filme acabar."
                    android:textColor="#A1A1AA"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtCinemaEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="#121218"
                android:padding="14dp"
                android:text="Nenhum filme agendado no momento. Volte em breve ou assista Ao Vivo."
                android:textColor="#A1A1AA"
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/cinemaScheduleContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
